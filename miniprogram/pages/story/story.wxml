<view class="container">
  <!-- 返回按钮 -->
  <view class="back-button" bindtap="handleGoBack" style="top: {{navTop}}px; height: {{navHeight}}px;">
    <image src="/images/go_back.png" mode="aspectFit"></image>
  </view>

  <!-- 背景层（固定不动） -->
  <view class="background-layer {{writingStatus.writing_state === 1 ? 'active' : ''}}"></view>

  <!-- 内容滚动层 -->
  <scroll-view class="content-scroll" scroll-y="{{hasArticles}}" enable-flex="true">
    <view class="content-wrapper">
      <!-- 安全区域占位 -->
      <view class="safe-area-top"></view>
      
      <!-- 主内容 -->
      <view class="content {{!hasArticles ? 'no-scroll' : ''}}">
        <!-- AI 消息容器 -->
        <!-- 显示条件：
             1. 无文章 (!hasArticles)
             2. 或者 正在写作 (writingStatus.writing_state === 1)
             3. 或者 有更新 (writingStatus.ready) 
        -->
        <view class="ai-message-container {{hasArticles ? 'compact' : ''}}" 
              wx:if="{{!hasArticles || writingStatus.writing_state === 1 || writingStatus.ready}}">
          <!-- AI 虚拟形象 -->
          <view class="top-section">
            <image class="ai-avatar" src="/images/AI_Avatar.png" mode="aspectFit"></image>
          </view>
    
          <!-- AI 字幕气泡 -->
          <view class="middle-section">
            <view class="ai-subtitle-bubble {{writingStatus.writing_state === 1 ? 'thinking-bubble' : ''}}">
              <view class="ai-subtitle-scroll">
                <!-- 文案显示逻辑 -->
                <text class="ai-subtitle-text" wx:if="{{writingStatus.writing_state === 1}}">正在写作中…\n大概需要几分钟\n写完后将自动更新文章</text>
                <text class="ai-subtitle-text" wx:elif="{{hasArticles && writingStatus.ready}}">我又有了足够多的新故事啦\n现在要更新一下文章吗?</text>
                <text class="ai-subtitle-text" wx:else>念念还没有足够多的素材，\n请先和念念讲讲你的故事吧</text>
              </view>
              
              <!-- 按钮显示逻辑 -->
              <!-- 1. 开始讲述按钮（仅无文章且未写作时显示） -->
              <view wx:if="{{!hasArticles && writingStatus.writing_state === 0}}" class="bubble-btn-container">
                <button class="bubble-btn" bindtap="onGoToInterview">
                  <image class="bubble-btn-icon" src="/images/microphone_white.png" mode="heightFix"></image>
                  <text>开始讲述</text>
                </button>
              </view>

              <!-- 2. 开始写作按钮（仅有文章且准备好且未写作时显示） -->
              <view wx:if="{{hasArticles && writingStatus.ready && writingStatus.writing_state === 0}}" class="bubble-btn-container">
                <button class="bubble-btn" bindtap="onStartWriting">
                  <image class="bubble-btn-icon" src="/images/writing_white.png" mode="heightFix"></image>
                  <text>开始写作</text>
                </button>
              </view>
            </view>
          </view>
        </view>

    <!-- 文章内容展示 -->
    <view wx:if="{{hasArticles}}" class="articles-container">
      <block wx:for="{{displayedArticles}}" wx:key="chapter_id" wx:for-item="chapter">
        <!-- 章节标题 -->
        <view class="chapter-header">
          <text class="chapter-title">{{chapter.chapter_name}}</text>
        </view>

        <!-- 章节内的sections -->
        <block wx:for="{{chapter.sections}}" wx:key="section_id" wx:for-item="section">
          <view class="section-container">
            <!-- Section 标题 -->
            <view wx:if="{{section.section_name}}" class="section-title">
              <image class="section-icon" src="/images/section_tag.png" mode="heightFix"></image>
              <text>{{section.section_name}}</text>
            </view>
            
            <!-- Section 内容 -->
            <view class="section-content">{{section.section_content}}</view>
          </view>
        </block>
      </block>

      <!-- 加载更多按钮 -->
      <view wx:if="{{currentPage < totalPages}}" class="load-more-container">
        <button class="load-more-btn" bindtap="onLoadMore">加载更多</button>
      </view>

      <!-- 已加载全部 -->
      <view wx:if="{{currentPage >= totalPages && totalPages > 1}}" class="end-tip">
        <text>已加载全部内容</text>
      </view>
    </view>
      </view>
    </view>
  </scroll-view>
</view>
