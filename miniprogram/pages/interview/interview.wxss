/* ==================== 页面级别禁止滚动 ==================== */
page {
  height: 100%;
  overflow: hidden;
}

/* ==================== 全局容器 ==================== */
/* ==================== 全局容器 ==================== */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
  /* 移除 overflow:hidden，允许子元素溢出（如反馈按钮的阴影） */
  /* overflow: hidden; */
  /* 流动渐变背景 - 使用全局变量 */
  background: var(--bg-gradient-colors);
  background-size: 400% 400%;
  animation: gradient-flow var(--bg-speed-normal) ease infinite;
  opacity: 1;
}

/* 移除本地动画定义，使用 app.wxss 中的全局定义 */

/* 半透明遮罩层 - 用于控制整体不透明度 */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 默认状态：使用全局变量 */
  background: rgba(255, 255, 255, var(--bg-mask-opacity-interview)); 
  pointer-events: none;
  z-index: 0;
  /* 添加过渡动画，使透明度变化平滑 */
  transition: background 1s ease;
}

/* 激活状态（思考/说话）：使用全局变量 */
.container.fast-bg::before {
  background: rgba(255, 255, 255, var(--bg-mask-opacity-active));
}

/* ==================== 返回按钮 ==================== */
.back-button {
  position: absolute;
  left: 20px;
  width: 44px; /* 增大点击区域宽度 */
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: flex-start; /* 左对齐 */
  padding: 0;
}

.back-button image {
  width: 32px;
  height: 32px;
}




/* ==================== Top 区：AI 虚拟形象 ==================== */
.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1; /* 确保显示在背景之上 */
}

.ai-avatar {
  display: block;
  width: 360px;
  height: 180px;
  margin-top: 108px;
}

/* ==================== Middle 区：AI 字幕气泡 ==================== */
.middle-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 20px 20px 20px; /* 恢复 padding-top 为 0，消除与头像的缝隙 */
  overflow: visible; /* 保持 visible，让 -3px 的光晕自然覆盖在头像上 */
  position: relative;
  z-index: 10; /* 提高层级，防止被Avatar遮挡 */
}

.ai-subtitle-bubble {
  background: #ffffff; /* 确保背景是纯白且不透明 */
  border-radius: 30px;
  padding: 20px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  max-height: 185px; /* 5行文字: 22px × 1.5 × 5 + 40px(上下padding) = 185px */
  overflow: visible; /* 必须设为 visible 才能显示外发光 */
  /* transform: translateZ(0);  <-- 移除此行，它导致了背景色混合问题 */
  position: relative;
  z-index: auto; /* 让 ::before 的 -1 生效（相对于 middle-section） */
}

.ai-subtitle-scroll {
  max-height: 148.5px; /* 4.5行文字: 22px × 1.5 × 4.5 = 148.5px */
  width: 100%;
}

/* 隐藏滚动条 - 微信小程序 */
.ai-subtitle-scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
}

.ai-subtitle-scroll {
  scrollbar-width: none !important; /* Firefox */
  -ms-overflow-style: none !important; /* IE/Edge */
  overflow-y: scroll !important;
  overflow-x: hidden !important;
}

/* 思考中状态：彩虹渐变边框动画 */
/* 思考中/说话中状态：彩虹渐变边框动画 */
.ai-subtitle-bubble.active-bubble {
  position: relative;
  background: #ffffff; /* 再次确认激活时背景纯白 */
  border: none;
  box-shadow: none;
}

/* 伪元素常驻，通过 opacity 控制显隐，实现渐变消失 */
.ai-subtitle-bubble::before {
  content: '';
  position: absolute;
  top: -3px;
  left: -3px;
  right: -3px;
  bottom: -3px;
  border-radius: 33px;
  /* 使用全局变量 */
  background: var(--bubble-border-gradient);
  background-size: 300% 100%;
  animation: rainbow-border var(--bubble-border-speed) linear infinite;
  z-index: -1;
  
  /* 关键：默认隐藏，添加过渡动画 */
  opacity: 0;
  transition: opacity 0.5s ease-in-out;
}

/* 激活状态下显示 */
.ai-subtitle-bubble.active-bubble::before {
  opacity: 1;
}

/* 背景加速类 - 使用全局变量 */
.container.fast-bg {
  animation-duration: var(--bg-speed-active) !important;
}

.ai-subtitle-text {
  font-size: 22px;
  font-weight: 600;
  color: #373737;
  line-height: 1.5;
}

.ai-subtitle-text.thinking {
  color: #A6A6A6; /* PRD规定: 思考中文字颜色 */
  font-weight: 600;
}

/* 反馈入口按钮容器 - 位于 AI 气泡下方 */
.feedback-entry {
  width: 100%;
  display: flex;
  justify-content: flex-end; /* 右对齐 */
  padding-right: 20px; /* 距右侧 20px */
  box-sizing: border-box;
  margin-top: 15px; /* 距离 AI 字幕板 15px */
  position: relative;
  z-index: 10;
}

/* 复用故事页按钮样式 */
.feedback-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2px; 
  width: 100px !important; /* 强制宽度 100px */
  height: 36px;
  min-height: 36px;
  padding: 0 6px; /* 调整内边距 */
  margin: 0;
  line-height: 36px;
  border-radius: 18px;
  background: linear-gradient(45deg, #FFB9AC 0%, #E6AACF 100%);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  font-size: 14px; /* 稍微减小字号以适应 90px */
  font-weight: 600;
  color: #FFFFFF;
  border: none;
}

.feedback-btn::after {
  border: none;
}

.feedback-btn-icon {
  width: 20px; /* 增大图标 */
  height: 20px;
  display: block;
  flex-shrink: 0;
}

/* ==================== Bottom 区：用户输入区 ==================== */
.bottom-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40px;
  position: relative;
  z-index: 1; /* 确保显示在背景之上 */
}

/* 用户字幕滚动容器 */
.user-subtitle-scroll {
  max-height: 185px; /* 4.5行文字: 22px × 1.6 × 4.5 + 40px(padding) = 198.4px, 留一些空间显示4.5行 */
  width: 675rpx;
  margin-bottom: 20px;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 30px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  padding: 20px;
  box-sizing: border-box;
}

/* 隐藏用户字幕滚动条 */
.user-subtitle-scroll::-webkit-scrollbar {
  display: none !important;
  width: 0 !important;
  height: 0 !important;
  background: transparent !important;
}

.user-subtitle-scroll {
  scrollbar-width: none !important; /* Firefox */
  -ms-overflow-style: none !important; /* IE/Edge */
  overflow-y: scroll !important;
  overflow-x: hidden !important;
}

/* 用户字幕淡出动画 - 背景淡出 + 向上移动营造发送感 */
.user-subtitle-scroll.fading {
  background: rgba(255, 255, 255, 0) !important;
  box-shadow: none !important;
  /* 向上移动 40rpx (约 20px 物理距离，不同机型一致) */
  transform: translateY(-40rpx);
  transition: background 0.5s ease, box-shadow 0.5s ease, transform 0.5s ease;
}

/* 用户字幕气泡 */
.user-subtitle-bubble {
  width: 100%;
  box-sizing: border-box;
}

.user-subtitle-text {
  font-size: 22px;
  font-weight: 600;
  color: #373737;
  line-height: 1.5;
  transition: opacity 0.5s ease;
}

/* 淡出状态下的文字：透明度降至 0.5 */
.user-subtitle-scroll.fading .user-subtitle-text {
  opacity: 0.5;
}


/* ==================== 控制按钮组 ==================== */
.control-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 675rpx;
  gap: 15px; /* 固定物理间距 */
  box-sizing: border-box;
}

/* 讲述按钮（长条形）*/
.narration-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 50px;
  border-radius: 25px;
  background: #FFFFFF;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  font-size: 20px;
  font-weight: 600;
  color: #373737;
  /* 清除button默认样式 */
  border: none;
  padding: 0 20px;
  margin: 0;
  box-sizing: border-box;
  line-height: normal;
}

.narration-btn .mic-icon {
  width: 20px;
  height: 20px;
}

.narration-btn.disabled {
  opacity: 0.5;
  color: #A6A6A6;
}

/* 圆形按钮 */
.circle-btn {
  width: 50px;
  height: 50px;
  min-width: 50px;
  max-width: 50px;
  border-radius: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  /* 清除button默认样式 */
  padding: 0;
  margin: 0;
  border: none;
  flex-shrink: 0;
  box-sizing: border-box;
  line-height: normal;
  overflow: hidden;
}

.circle-btn image {
  width: 50px;
  height: 50px;
}

.circle-btn.disabled {
  opacity: 0.5;
}

/* 取消按钮（红色背景）*/
.circle-btn.cancel-btn {
  background: #FFFFFF;
}

.cancel-icon {
  font-size: 24px;
  font-weight: 300;
  color: #FF6B6B;
}

/* 发送按钮（白色背景，绿色箭头）*/
.circle-btn.send-btn {
  background: #FFFFFF;
}

.send-icon {
  font-size: 22px;
  font-weight: 600;
  color: #4ECDC4;
}

/* ==================== 音频指示器 ==================== */
.voice-indicator {
  width: 194px; /* 154px内容 + 40px内边距 */
  min-width: 194px;
  max-width: 194px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  height: 50px;
  border-radius: 25px;
  background: #373737;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
  padding: 0 20px;
  flex-shrink: 0;
  box-sizing: border-box; /* 关键：确保padding包含在宽度内 */
}

.voice-waveform {
  display: flex;
  align-items: center;
  gap: 5px;
}

.wave-bar {
  width: 4px;
  border-radius: 2px;
  background: #FFFFFF;
}

/* 每条竖杠使用不同的随机动画 */
.wave-bar:nth-child(1) { 
  height: 8px; 
  animation: wave-random-1 0.8s ease-in-out infinite;
}
.wave-bar:nth-child(2) { 
  height: 12px; 
  animation: wave-random-2 0.7s ease-in-out infinite;
}
.wave-bar:nth-child(3) { 
  height: 16px; 
  animation: wave-random-3 0.9s ease-in-out infinite;
}
.wave-bar:nth-child(4) { 
  height: 14px; 
  animation: wave-random-4 0.75s ease-in-out infinite;
}
.wave-bar:nth-child(5) { 
  height: 16px; 
  animation: wave-random-5 0.85s ease-in-out infinite;
}
.wave-bar:nth-child(6) { 
  height: 12px; 
  animation: wave-random-6 0.8s ease-in-out infinite;
}

/* 随机动画 - 模拟讲话中的混乱高度变化 */
@keyframes wave-random-1 {
  0%, 100% { transform: scaleY(1); }
  25% { transform: scaleY(1.5); }
  50% { transform: scaleY(0.8); }
  75% { transform: scaleY(1.8); }
}

@keyframes wave-random-2 {
  0%, 100% { transform: scaleY(1); }
  30% { transform: scaleY(1.8); }
  60% { transform: scaleY(1.2); }
  80% { transform: scaleY(0.9); }
}

@keyframes wave-random-3 {
  0%, 100% { transform: scaleY(1); }
  20% { transform: scaleY(0.9); }
  45% { transform: scaleY(1.6); }
  70% { transform: scaleY(1.3); }
}

@keyframes wave-random-4 {
  0%, 100% { transform: scaleY(1); }
  35% { transform: scaleY(1.4); }
  55% { transform: scaleY(0.85); }
  85% { transform: scaleY(1.7); }
}

@keyframes wave-random-5 {
  0%, 100% { transform: scaleY(1); }
  15% { transform: scaleY(1.6); }
  40% { transform: scaleY(1.1); }
  75% { transform: scaleY(0.95); }
}

@keyframes wave-random-6 {
  0%, 100% { transform: scaleY(1); }
  28% { transform: scaleY(0.88); }
  52% { transform: scaleY(1.5); }
  78% { transform: scaleY(1.25); }
}

.voice-timer {
  font-size: 20px;
  font-weight: 600;
  color: #FFFFFF;
}

/* 按钮重置 - 清除微信小程序button默认样式 */
button {
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  line-height: normal;
}

button::after {
  border: none;
}
